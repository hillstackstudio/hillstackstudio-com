---
import siteContext from '../data/siteContext.json';

export interface Props {
  companyName?: string;
  email?: string;
  hours?: string;
  regionalKeywords?: string[];
}

const {
  companyName = siteContext.companyName,
  email = siteContext.contact.email,
  hours = siteContext.contact.hours,
  regionalKeywords = siteContext.regionalKeywords
} = Astro.props;
---

<footer class="w-full text-slate-600 py-16 border-t border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-10">
    <!-- Brand Info & Regional Presence -->
    <div class="md:col-span-2">
      <a 
        href="/" 
        class="flex items-center gap-2.5 sm:gap-3 mb-4 select-none group w-fit transition-all duration-200" 
        aria-label="Hill Stack Studio Home"
      >
        <img 
          src="/dark-logo.svg" 
          alt="Hill Stack Studio Logo" 
          class="h-9 sm:h-10 w-auto object-contain rounded-xl shadow-xs group-hover:scale-105 transition-transform shrink-0" 
        />
        <span class="text-base sm:text-lg font-bold text-[#0f172a] tracking-tight whitespace-nowrap leading-none pl-0.5">
          Hill Stack <span class="font-normal text-slate-500">Studio</span>
        </span>
      </a>
      <div class="space-y-2">
        <div class="flex items-center gap-2 text-base text-slate-600 font-medium">
          <svg class="w-5 h-5 text-[#0B0F19] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
          <span>Based in Seattle, WA</span>
        </div>
        <div class="flex items-center gap-2 text-base text-slate-600 font-medium">
          <svg class="w-5 h-5 text-[#0B0F19] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.25c-.3 0-.58.15-.74.4l-5 7.5a.89.89 0 0 0 .74 1.35h1.22l-3.48 4.64a.89.89 0 0 0 .71 1.43h1.76l-3.95 5.27a.89.89 0 0 0 .71 1.43H11v2a1 1 0 0 0 2 0v-2h6.03a.89.89 0 0 0 .71-1.43l-3.95-5.27h1.76a.89.89 0 0 0 .71-1.43L14.78 11.5H16a.89.89 0 0 0 .74-1.35l-5-7.5a.89.89 0 0 0-.74-.4z"/>
          </svg>
          <span>Serving Clients Across the Pacific Northwest</span>
        </div>
      </div>

      <!-- Regional Presence (Desktop: inside Column 1) -->
      <div class="hidden md:block mt-6 pt-5 border-t border-slate-200/60 max-w-lg">
        <h4 class="text-[#0B0F19] text-xs font-bold uppercase tracking-wider mb-2.5">Regional Presence</h4>
        <ul class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-sm text-slate-600">
          {regionalKeywords
            .filter((area) => area.toLowerCase() !== 'pacific northwest')
            .map((area, index, arr) => (
              <li class="flex items-center gap-2.5">
                <span>{area}</span>
                {index < arr.length - 1 && <span class="text-slate-300" aria-hidden="true">•</span>}
              </li>
            ))}
        </ul>
      </div>
    </div>

    <!-- Navigation Quick Links -->
    <div>
      <h4 class="text-[#0B0F19] text-sm font-bold uppercase tracking-wider mb-4">Navigation</h4>
      <ul class="space-y-2.5 text-sm">
        <li><a href="/" class="hover:text-black transition-colors">Home</a></li>
        <li><a href="/about" class="hover:text-black transition-colors">About Us</a></li>
        <li><a href="/#recent-work" class="hover:text-black transition-colors">Our Work</a></li>
        <li><a href="/services" class="hover:text-black transition-colors">Services</a></li>
        <li><a href="/#contact" class="hover:text-black transition-colors">Contact</a></li>
      </ul>
    </div>

    <!-- Contact Info -->
    <div>
      <h4 class="text-[#0B0F19] text-sm font-bold uppercase tracking-wider mb-4">Contact Info</h4>
      <ul class="space-y-3 text-sm">
        <li class="flex items-center gap-2">
          <span class="font-medium text-slate-700">Email:</span>
          <a href={`mailto:${email}`} class="text-slate-600 hover:text-black transition-colors">
            {email}
          </a>
        </li>
        <li class="flex items-center gap-2">
          <span class="font-medium text-slate-700">Hours:</span>
          <span class="text-slate-600">{hours}</span>
        </li>
      </ul>

      <!-- Regional Presence (Mobile: under Contact Info) -->
      <div class="block md:hidden mt-8 pt-6 border-t border-slate-200/60">
        <h4 class="text-[#0B0F19] text-xs font-bold uppercase tracking-wider mb-2.5">Regional Presence</h4>
        <ul class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-sm text-slate-600">
          {regionalKeywords
            .filter((area) => area.toLowerCase() !== 'pacific northwest')
            .map((area, index, arr) => (
              <li class="flex items-center gap-2.5">
                <span>{area}</span>
                {index < arr.length - 1 && <span class="text-slate-300" aria-hidden="true">•</span>}
              </li>
            ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 pt-8 border-t border-slate-200/80 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-slate-500">
    <div class="flex items-center justify-center md:justify-start md:flex-1 w-full md:w-auto">
      <img 
        src="/images/wcag-2.2-aa.png" 
        alt="WCAG 2.2 Level AA Conformance Badge" 
        class="h-9 sm:h-10 w-auto object-contain" 
        loading="lazy"
      />
    </div>

    <div class="flex flex-col md:flex-row items-center justify-center gap-2 md:gap-2.5 text-center whitespace-nowrap">
      <a href="/privacy" class="hover:text-black transition-colors">Privacy Policy</a>
      <span class="hidden md:inline text-slate-300" aria-hidden="true">|</span>
      <a href="/sitemap" class="hover:text-black transition-colors">Site Map</a>
      <span class="hidden md:inline text-slate-300" aria-hidden="true">|</span>
      <a href="/accessibility" class="hover:text-black transition-colors">Accessibility Statement</a>
    </div>

    <div class="flex items-center justify-center md:justify-end md:flex-1 w-full md:w-auto text-center md:text-right">
      <p>&copy; {new Date().getFullYear()} {companyName}.</p>
    </div>
  </div>
</footer>
