---
export interface Props {
  ctaText?: string;
  ctaHref?: string;
}

const {
  ctaText = "Get AI Audit",
  ctaHref = "#contact"
} = Astro.props;
---

<div class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-white/95 backdrop-blur-md border-t border-slate-200 p-3 shadow-2xl">
  <div class="max-w-md mx-auto flex items-center justify-center">
    {ctaText && (
      <a 
        href={ctaHref} 
        class="w-full py-3 bg-[#17A398] hover:bg-[#128279] text-white rounded-full font-bold text-sm text-center shadow-md shadow-teal-500/20 active:scale-95 transition-all"
      >
        {ctaText}
      </a>
    )}
  </div>
</div>
