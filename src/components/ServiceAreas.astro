---
export interface Props {
  title?: string;
  subtitle?: string;
  regionalKeywords?: string[];
}

const {
  title = "Service Areas & Regional Coverage",
  subtitle = "Proudly serving local businesses, contractors, and service providers across the PNW.",
  regionalKeywords = [
    "Seattle",
    "Bellevue",
    "Tacoma",
    "King County",
    "Pierce County",
    "Pacific Northwest"
  ]
} = Astro.props;
---

<section id="service-areas" class="py-20 bg-[#F8FAFC]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <span class="text-[#2563EB] text-sm font-bold uppercase tracking-wider mb-2 block">
      Regional Presence
    </span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0B0F19] tracking-tight mb-4">
      {title}
    </h2>
    <p class="text-slate-600 max-w-2xl mx-auto mb-12 text-base">
      {subtitle}
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {regionalKeywords.map((area) => (
        <div class="flex items-center gap-4 bg-white hover:bg-slate-50 border border-slate-200/80 rounded-2xl p-5 text-left transition-all duration-200 group shadow-xs hover:shadow-md">
          <div class="p-3 rounded-xl bg-blue-50 text-[#2563EB] group-hover:bg-[#2563EB] group-hover:text-white transition-colors shrink-0">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-[#0B0F19] font-bold text-base group-hover:text-[#2563EB] transition-colors">{area}</h3>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
