---
export interface Props {
  companyName?: string;
  email?: string;
  navItems?: Array<{ label: string; href: string }>;
  transparentAtTop?: boolean;
}

const {
  companyName = "Hill Stack Studio",
  navItems = [
    { label: "About Us", href: "/about" },
    { label: "Our Work", href: "/#recent-work" },
    { label: "Services", href: "/services" },
    { label: "Pricing", href: "/#pricing" },
    { label: "Contact", href: "/#contact" }
  ],
  transparentAtTop: _transparentAtTop = false
} = Astro.props;
---

<header 
  id="main-header"
  class="sticky top-0 relative z-50 w-full pt-3 sm:pt-4 px-3 sm:px-6 lg:px-8 pointer-events-none transition-all duration-300"
>
  <!-- Floating Pill Navbar Bar -->
  <div 
    id="navbar-inner"
    class="pointer-events-auto max-w-6xl mx-auto bg-white/75 backdrop-blur-xl rounded-2xl sm:rounded-[22px] border border-white/60 shadow-[0_8px_30px_rgb(0,0,0,0.06)] px-4 sm:px-6 h-16 sm:h-[66px] flex items-center justify-between relative transition-all duration-300"
  >
    <!-- Brand Logo & Wordmark (Left) -->
    <a 
      id="brand-logo-link"
      href="/" 
      class="flex items-center gap-2.5 sm:gap-3 py-1.5 select-none shrink-0 group transition-all duration-200" 
      aria-label={`${companyName} Home`}
    >
      <img 
        src="/dark-logo.svg" 
        alt={`${companyName} Icon`}
        class="h-10 sm:h-11 w-auto object-contain rounded-xl group-hover:scale-105 transition-transform shrink-0 shadow-xs" 
      />
      <span class="text-base sm:text-lg font-bold text-[#0f172a] tracking-tight whitespace-nowrap leading-none pl-0.5">
        Hill Stack <span class="font-normal text-slate-500">Studio</span>
      </span>
    </a>

    <!-- Desktop Navigation Links (Center) -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class="text-sm lg:text-[15px] font-medium text-slate-700 hover:text-black px-3.5 py-1.5 rounded-xl hover:bg-white/60 transition-all"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right Side Actions: CTA Button & Mobile Menu Toggle -->
    <div class="flex items-center gap-2.5 sm:gap-3">
      <a 
        href="/#contact" 
        class="hidden md:inline-flex items-center justify-center px-5 py-2 text-sm font-medium text-white bg-black hover:bg-neutral-800 active:bg-neutral-900 rounded-full transition-all duration-150 shadow-xs select-none"
      >
        Let's Chat
      </a>

      <!-- Mobile / Tablet Hamburger Toggle Button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="flex md:hidden items-center justify-center w-10 h-10 rounded-xl hover:bg-white/60 text-slate-800 transition-colors outline-none focus:outline-none select-none"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <!-- Hamburger Icon -->
        <svg id="hamburger-icon" class="w-5 h-5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close 'X' Icon -->
        <svg id="close-icon" class="w-5 h-5 hidden transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile / Tablet Floating Navigation Panel (Overlays the page without shifting content) -->
  <div
    id="mobile-menu"
    class="pointer-events-auto hidden md:hidden absolute top-full left-3 right-3 sm:left-6 sm:right-6 max-w-6xl mx-auto mt-2 bg-white/85 backdrop-blur-2xl rounded-2xl border border-white/60 shadow-[0_16px_40px_-8px_rgba(15,23,42,0.12)] p-4 transition-all duration-200 z-50 max-h-[calc(100dvh-5.5rem)] overflow-y-auto overscroll-contain"
  >
    <div class="flex flex-col gap-1">
      {/* About Us Link */}
      <a
        href="/about"
        class="mobile-nav-link p-2 text-base font-medium text-slate-800 hover:text-black rounded-xl hover:bg-slate-100/80 transition-colors"
      >
        About Us
      </a>

      {/* Our Work Link */}
      <a
        href="/#recent-work"
        class="mobile-nav-link p-2 text-base font-medium text-slate-800 hover:text-black rounded-xl hover:bg-slate-100/80 transition-colors"
      >
        Our Work
      </a>

      {/* Services Link */}
      <a
        href="/services"
        class="mobile-nav-link p-2 text-base font-medium text-slate-800 hover:text-black rounded-xl hover:bg-slate-100/80 transition-colors"
      >
        Services
      </a>

      {/* Pricing Link */}
      <a
        href="/#pricing"
        class="mobile-nav-link p-2 text-base font-medium text-slate-800 hover:text-black rounded-xl hover:bg-slate-100/80 transition-colors"
      >
        Pricing
      </a>

      {/* Contact Link */}
      <a
        href="/#contact"
        class="mobile-nav-link p-2 text-base font-medium text-slate-800 hover:text-black rounded-xl hover:bg-slate-100/80 transition-colors"
      >
        Contact
      </a>
    </div>

    {/* Let's Chat CTA Button */}
    <div class="mt-3 pt-3 border-t border-slate-100/80">
      <a
        href="/#contact"
        class="mobile-nav-link flex items-center justify-center gap-2 w-full py-2.5 px-5 text-sm font-semibold text-white bg-black hover:bg-neutral-800 active:bg-neutral-900 rounded-full transition-colors shadow-xs"
      >
        <span>Let's Chat</span>
        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  // Frosted glass elevation on scroll
  const navbarInner = document.getElementById('navbar-inner');
  
  if (navbarInner) {
    const handleScroll = () => {
      if (window.scrollY > 15) {
        navbarInner.classList.add(
          'bg-white/85',
          'backdrop-blur-2xl',
          'border-white/70',
          'shadow-[0_12px_36px_rgb(0,0,0,0.08)]'
        );
        navbarInner.classList.remove(
          'bg-white/75',
          'backdrop-blur-xl',
          'border-white/60',
          'shadow-[0_8px_30px_rgb(0,0,0,0.06)]'
        );
      } else {
        navbarInner.classList.add(
          'bg-white/75',
          'backdrop-blur-xl',
          'border-white/60',
          'shadow-[0_8px_30px_rgb(0,0,0,0.06)]'
        );
        navbarInner.classList.remove(
          'bg-white/85',
          'backdrop-blur-2xl',
          'border-white/70',
          'shadow-[0_12px_36px_rgb(0,0,0,0.08)]'
        );
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  // Mobile/Tablet Hamburger Menu logic
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (menuButton && mobileMenu) {
    const toggleMenu = () => {
      menuButton.blur();
      const isOpen = !mobileMenu.classList.contains('hidden');
      if (isOpen) {
        mobileMenu.classList.add('hidden');
        menuButton.setAttribute('aria-expanded', 'false');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
        menuButton.setAttribute('aria-expanded', 'true');
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      }
    };

    menuButton.addEventListener('click', toggleMenu);

    // Close mobile menu when navigating
    const navLinks = mobileMenu.querySelectorAll('.mobile-nav-link');
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuButton.setAttribute('aria-expanded', 'false');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      });
    });

    // Close mobile menu when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (
        !mobileMenu.classList.contains('hidden') &&
        target &&
        !mobileMenu.contains(target) &&
        !menuButton.contains(target)
      ) {
        mobileMenu.classList.add('hidden');
        menuButton.setAttribute('aria-expanded', 'false');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    });

    // Close mobile menu on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
        mobileMenu.classList.add('hidden');
        menuButton.setAttribute('aria-expanded', 'false');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        menuButton.focus();
      }
    });
  }
</script>
