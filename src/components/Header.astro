---
import siteContext from '../data/siteContext.json';

export interface Props {
  companyName?: string;
  email?: string;
  navItems?: Array<{ label: string; href: string }>;
  transparentAtTop?: boolean;
}

const {
  companyName = "Hill Stack Studio",
  navItems = [
    { label: "About Us", href: "/about" },
    { label: "Work", href: "/#recent-work" },
    { label: "Services", href: "/services" },
    { label: "Contact", href: "/#contact" }
  ],
  transparentAtTop = false
} = Astro.props;

// 3 core services for the dropdown matching "Our solutions" section order
const servicesList = [
  {
    name: siteContext.services[0]?.name || "AEO & SEO Website Audit",
    href: "/services/answer-engine-optimization",
    svgPath: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
  },
  {
    name: siteContext.services[1]?.name || "Custom Web Design & Development",
    href: "/services/custom-web-design-development",
    svgPath: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
  },
  {
    name: siteContext.services[2]?.name || "Hosting & Administration",
    href: "/services#hosting",
    svgPath: "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"
  }
];

---

<header 
  id="main-header"
  class="sticky top-0 relative z-50 w-full pt-3 sm:pt-4 px-3 sm:px-6 lg:px-8 pointer-events-none transition-all duration-300"
>
  <!-- Floating Pill Navbar Bar -->
  <div 
    id="navbar-inner"
    class="pointer-events-auto max-w-6xl mx-auto bg-white/75 backdrop-blur-xl rounded-2xl sm:rounded-[22px] border border-white/60 shadow-[0_8px_30px_rgb(0,0,0,0.06)] px-4 sm:px-6 h-16 sm:h-[66px] flex items-center justify-between relative transition-all duration-300"
  >
    <!-- Brand Logo & Wordmark (Left) -->
    <a 
      id="brand-logo-link"
      href="/" 
      class="flex items-center gap-2.5 sm:gap-3 py-1.5 select-none shrink-0 group transition-all duration-200" 
      aria-label="Hill Stack Studio Home"
    >
      <img 
        src="/dark-logo.svg" 
        alt="Hill Stack Studio Icon" 
        class="h-10 sm:h-11 w-auto object-contain rounded-xl group-hover:scale-105 transition-transform shrink-0 shadow-xs" 
      />
      <span class="text-base sm:text-lg font-bold text-[#0f172a] tracking-tight whitespace-nowrap leading-none pl-0.5">
        Hill Stack <span class="font-normal text-slate-500">Studio</span>
      </span>
    </a>

    <!-- Desktop Navigation Links (Center) -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      {navItems.map(item => {
        const isServices = item.label === "Services";

        if (isServices) {
          return (
            <div class="relative group/dropdown py-2">
              <a 
                href={item.href} 
                class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-sm lg:text-[15px] font-medium text-slate-700 hover:text-black hover:bg-white/60 group-hover/dropdown:bg-white/80 group-hover/dropdown:text-black group-hover/dropdown:shadow-xs transition-all"
              >
                <span>{item.label}</span>
                <svg 
                  class="w-3.5 h-3.5 text-slate-400 group-hover/dropdown:text-black group-hover/dropdown:rotate-180 transition-transform duration-200" 
                  fill="none" 
                  viewBox="0 0 24 24" 
                  stroke="currentColor" 
                  stroke-width="2.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>

              {/* Services Dropdown Panel */}
              <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible group-hover/dropdown:opacity-100 group-hover/dropdown:visible transition-all duration-200 transform translate-y-1 group-hover/dropdown:translate-y-0 pointer-events-none group-hover/dropdown:pointer-events-auto z-50">
                <div class="w-[320px] sm:w-[340px] bg-white/85 backdrop-blur-2xl rounded-2xl border border-white/60 shadow-[0_16px_40px_-8px_rgba(15,23,42,0.12)] p-2">
                  <div class="flex flex-col gap-1">
                    {servicesList.map((service) => (
                      <a 
                        href={service.href} 
                        class="flex items-center gap-3 p-2 rounded-xl hover:bg-white/70 transition-colors group/item"
                      >
                        <div class="w-9 h-9 rounded-xl bg-slate-100/80 text-slate-700 group-hover/item:bg-white group-hover/item:shadow-xs flex items-center justify-center shrink-0 transition-colors">
                          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d={service.svgPath} />
                          </svg>
                        </div>
                        <span class="text-sm font-semibold text-slate-900 group-hover/item:text-black transition-colors leading-tight">
                          {service.name}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          );
        }

        return (
          <a 
            href={item.href} 
            class="text-sm lg:text-[15px] font-medium text-slate-700 hover:text-black px-3.5 py-1.5 rounded-xl hover:bg-white/60 transition-all"
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Side Actions: CTA Button & Mobile Menu Toggle -->
    <div class="flex items-center gap-2.5 sm:gap-3">
      <a 
        href="/#contact" 
        class="hidden md:inline-flex items-center justify-center px-5 py-2 text-sm font-medium text-white bg-black hover:bg-neutral-800 active:bg-neutral-900 rounded-full transition-all duration-150 shadow-xs select-none"
      >
        Request Audit
      </a>

      <!-- Mobile / Tablet Hamburger Toggle Button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="flex md:hidden items-center justify-center w-10 h-10 rounded-xl hover:bg-white/60 text-slate-800 transition-colors outline-none focus:outline-none select-none"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <!-- Hamburger Icon -->
        <svg id="hamburger-icon" class="w-5 h-5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close 'X' Icon -->
        <svg id="close-icon" class="w-5 h-5 hidden transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile / Tablet Floating Navigation Panel (Overlays the page without shifting content) -->
  <div
    id="mobile-menu"
    class="pointer-events-auto hidden md:hidden absolute top-full left-3 right-3 sm:left-6 sm:right-6 max-w-6xl mx-auto mt-2 bg-white/85 backdrop-blur-2xl rounded-2xl border border-white/60 shadow-[0_16px_40px_-8px_rgba(15,23,42,0.12)] p-4 transition-all duration-200 z-50 max-h-[calc(100dvh-5.5rem)] overflow-y-auto overscroll-contain"
  >
    <div class="flex flex-col gap-1">
      {/* About Us Link */}
      <a
        href="/about"
        class="mobile-nav-link p-2 text-base font-medium text-slate-800 hover:text-black rounded-xl hover:bg-slate-100/80 transition-colors"
      >
        About Us
      </a>

      {/* Work Link */}
      <a
        href="/#recent-work"
        class="mobile-nav-link p-2 text-base font-medium text-slate-800 hover:text-black rounded-xl hover:bg-slate-100/80 transition-colors"
      >
        Work
      </a>

      {/* Services Link & Accordion */}
      <div class="mobile-accordion-item rounded-xl overflow-hidden">
        <div class="flex items-center justify-between p-2 rounded-xl hover:bg-slate-100/80 transition-colors">
          <a
            href="/services"
            class="mobile-nav-link text-base font-medium text-slate-800 hover:text-black transition-colors"
          >
            Services
          </a>
          <button
            type="button"
            class="mobile-accordion-button p-1 text-slate-500 hover:text-black rounded-lg transition-colors"
            aria-label="Toggle Services List"
          >
            <svg class="w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
        <div class="mobile-accordion-content hidden border-t border-slate-100 mt-1 pt-1.5 pl-2 space-y-1">
          {servicesList.map((service) => (
            <a
              href={service.href}
              class="mobile-nav-link flex items-center gap-3 p-2 rounded-lg hover:bg-slate-100/80 transition-colors"
            >
              <div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={service.svgPath} />
                </svg>
              </div>
              <span class="text-sm font-medium text-slate-700 leading-tight">
                {service.name}
              </span>
            </a>
          ))}
        </div>
      </div>

      {/* Contact Link */}
      <a
        href="/#contact"
        class="mobile-nav-link p-2 text-base font-medium text-slate-800 hover:text-black rounded-xl hover:bg-slate-100/80 transition-colors"
      >
        Contact
      </a>
    </div>

    {/* Request Audit CTA Button */}
    <div class="mt-3 pt-3 border-t border-slate-100/80">
      <a
        href="/#contact"
        class="mobile-nav-link flex items-center justify-center gap-2 w-full py-2.5 px-5 text-sm font-semibold text-white bg-black hover:bg-neutral-800 active:bg-neutral-900 rounded-full transition-colors shadow-xs"
      >
        <span>Request Audit</span>
        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  // Frosted glass elevation on scroll
  const navbarInner = document.getElementById('navbar-inner');
  
  if (navbarInner) {
    const handleScroll = () => {
      if (window.scrollY > 15) {
        navbarInner.classList.add(
          'bg-white/85',
          'backdrop-blur-2xl',
          'border-white/70',
          'shadow-[0_12px_36px_rgb(0,0,0,0.08)]'
        );
        navbarInner.classList.remove(
          'bg-white/75',
          'backdrop-blur-xl',
          'border-white/60',
          'shadow-[0_8px_30px_rgb(0,0,0,0.06)]'
        );
      } else {
        navbarInner.classList.add(
          'bg-white/75',
          'backdrop-blur-xl',
          'border-white/60',
          'shadow-[0_8px_30px_rgb(0,0,0,0.06)]'
        );
        navbarInner.classList.remove(
          'bg-white/85',
          'backdrop-blur-2xl',
          'border-white/70',
          'shadow-[0_12px_36px_rgb(0,0,0,0.08)]'
        );
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  // Mobile/Tablet Hamburger Menu logic
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (menuButton && mobileMenu) {
    const toggleMenu = () => {
      menuButton.blur();
      const isOpen = !mobileMenu.classList.contains('hidden');
      if (isOpen) {
        mobileMenu.classList.add('hidden');
        menuButton.setAttribute('aria-expanded', 'false');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
        menuButton.setAttribute('aria-expanded', 'true');
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      }
    };

    menuButton.addEventListener('click', toggleMenu);

    // Submenu accordions in mobile menu
    const accordionButtons = mobileMenu.querySelectorAll('.mobile-accordion-button');
    accordionButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const parent = btn.closest('.mobile-accordion-item');
        const content = parent?.querySelector('.mobile-accordion-content');
        const svgIcon = btn.querySelector('svg');
        if (content) {
          content.classList.toggle('hidden');
          svgIcon?.classList.toggle('rotate-180');
        }
      });
    });

    // Close mobile menu when navigating
    const navLinks = mobileMenu.querySelectorAll('.mobile-nav-link');
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuButton.setAttribute('aria-expanded', 'false');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      });
    });

    // Close mobile menu when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (
        !mobileMenu.classList.contains('hidden') &&
        target &&
        !mobileMenu.contains(target) &&
        !menuButton.contains(target)
      ) {
        mobileMenu.classList.add('hidden');
        menuButton.setAttribute('aria-expanded', 'false');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    });

    // Close mobile menu on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
        mobileMenu.classList.add('hidden');
        menuButton.setAttribute('aria-expanded', 'false');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        menuButton.focus();
      }
    });
  }
</script>
