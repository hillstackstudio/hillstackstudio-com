---
import siteContext from '../data/siteContext.json';
import { servicesData } from '../data/servicesData';

export interface Props {
  companyName?: string;
  email?: string;
  navItems?: Array<{ label: string; href: string }>;
}

const {
  companyName = "Hill Stack Studio",
  navItems = [
    { label: "Company", href: "/#advantage" },
    { label: "Services", href: "/services" },
    { label: "Work", href: "/#recent-work" },
    { label: "Contact", href: "/#contact" }
  ]
} = Astro.props;

const servicesList = servicesData;

// 9 SVG Icons matching the Services page exactly
const serviceSvgPaths = [
  // 1. Custom Web Design & Development (Monitor)
  "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  // 2. Generative Engine Optimization (Lightning)
  "M13 10V3L4 14h7v7l9-11h-7z",
  // 3. Consulting & Site Migration (Exchange)
  "M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4",
  // 4. Web Hosting & Administration (Server)
  "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01",
  // 5. Search Engine Readiness (Code/Schema)
  "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
  // 6. Copywriting & Content Adjustments (Pencil)
  "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z",
  // 7. Performance & Visibility Audit (Chart)
  "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
  // 8. Accessibility Compliance (Eye)
  "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z",
  // 9. Security & Privacy Compliance (Shield)
  "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
];
---

<header 
  id="main-header"
  class="w-full bg-[#EFF6FF] border-b border-transparent sticky top-0 z-50 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between relative">
    <!-- Brand Logo & Wordmark -->
    <a 
      id="brand-logo-link"
      href="/" 
      class="flex items-center gap-3 group py-2 z-10 select-none transition-all duration-300 ease-in-out" 
      aria-label="Hill Stack Studio Home"
    >
      <img 
        src="/logo-icon.svg" 
        alt="Hill Stack Studio Icon" 
        class="h-8 sm:h-9 w-auto object-contain group-hover:scale-105 transition-transform shrink-0" 
      />
      <div 
        id="header-wordmark"
        class="flex items-center overflow-hidden transition-all duration-300 ease-in-out max-w-[240px] opacity-100 translate-x-0"
      >
        <span class="text-lg sm:text-xl font-display tracking-tight whitespace-nowrap leading-none pl-0.5">
          <span class="font-extrabold text-[#0f172a]">Hill Stack</span>
          <span class="font-normal text-slate-500"> Studio</span>
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center justify-center gap-8 absolute left-1/2 -translate-x-1/2">
      {navItems.map(item => {
        const isCompany = item.label === "Company";
        const isServices = item.label === "Services";

        if (isCompany) {
          return (
            <div class="relative group/dropdown py-6">
              <a 
                href={item.href} 
                class="flex items-center gap-1.5 text-base lg:text-lg font-medium text-slate-700 group-hover/dropdown:text-[#2563EB] transition-colors py-1"
              >
                <span>{item.label}</span>
                <svg 
                  class="w-4 h-4 opacity-60 text-slate-500 group-hover/dropdown:text-[#2563EB] group-hover/dropdown:rotate-180 transition-all duration-200" 
                  fill="none" 
                  viewBox="0 0 24 24" 
                  stroke="currentColor" 
                  stroke-width="2.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>

              {/* Company Dropdown Panel */}
              <div class="absolute top-full left-0 w-64 bg-white rounded-2xl border border-slate-200/80 shadow-2xl p-3.5 opacity-0 invisible group-hover/dropdown:opacity-100 group-hover/dropdown:visible transition-all duration-200 transform translate-y-2 group-hover/dropdown:translate-y-0 pointer-events-none group-hover/dropdown:pointer-events-auto z-50">
                <a 
                  href="/about" 
                  class="flex items-center gap-3.5 p-2.5 rounded-xl hover:bg-blue-50/60 transition-colors group/item"
                >
                  <div class="w-11 h-11 rounded-full bg-blue-50 text-[#2563EB] group-hover/item:bg-[#2563EB] group-hover/item:text-white flex items-center justify-center shrink-0 transition-colors shadow-xs">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                  </div>
                  <div>
                    <span class="text-base font-medium text-slate-800 group-hover/item:text-[#2563EB] transition-colors block">
                      About Us
                    </span>
                  </div>
                </a>
              </div>
            </div>
          );
        }

        if (isServices) {
          return (
            <div class="relative group/dropdown py-6">
              <a 
                href={item.href} 
                class="flex items-center gap-1.5 text-base lg:text-lg font-medium text-slate-700 group-hover/dropdown:text-[#2563EB] transition-colors py-1"
              >
                <span>{item.label}</span>
                <svg 
                  class="w-4 h-4 opacity-60 text-slate-500 group-hover/dropdown:text-[#2563EB] group-hover/dropdown:rotate-180 transition-all duration-200" 
                  fill="none" 
                  viewBox="0 0 24 24" 
                  stroke="currentColor" 
                  stroke-width="2.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>

              {/* 2-Column Mega-Menu Dropdown Panel matching screenshot */}
              <div class="absolute top-full left-1/2 -translate-x-1/2 sm:-translate-x-[40%] w-[640px] sm:w-[720px] bg-white rounded-3xl border border-slate-200/80 shadow-2xl p-6 sm:p-7 opacity-0 invisible group-hover/dropdown:opacity-100 group-hover/dropdown:visible transition-all duration-200 transform translate-y-2 group-hover/dropdown:translate-y-0 pointer-events-none group-hover/dropdown:pointer-events-auto z-50">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
                  {servicesList.map((service, index) => (
                    <a 
                      href={`/services/${service.slug}`} 
                      class="flex items-center gap-3.5 p-2.5 rounded-2xl hover:bg-blue-50/60 transition-colors group/item"
                    >
                      <div class="w-11 h-11 rounded-full bg-blue-50 text-[#2563EB] group-hover/item:bg-[#2563EB] group-hover/item:text-white flex items-center justify-center shrink-0 transition-colors shadow-xs">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d={serviceSvgPaths[index % serviceSvgPaths.length]} />
                        </svg>
                      </div>
                      <span class="text-base font-medium text-slate-800 group-hover/item:text-[#2563EB] transition-colors leading-snug">
                        {service.name}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
        }

        return (
          <a 
            href={item.href} 
            class="text-base lg:text-lg font-medium text-slate-700 hover:text-[#0B0F19] transition-colors relative py-1"
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Mobile / Tablet Hamburger Toggle Button -->
    <button
      id="mobile-menu-button"
      type="button"
      class="flex md:hidden items-center justify-center p-2.5 rounded-xl bg-[#2563EB] hover:bg-[#1D4ED8] text-white shadow-sm transition-all outline-none focus:outline-none focus:ring-0 focus-visible:outline-none active:outline-none ring-0 focus-visible:ring-0 [-webkit-tap-highlight-color:transparent] select-none z-20"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <!-- Hamburger Icon -->
      <svg id="hamburger-icon" class="w-6 h-6 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <!-- Close 'X' Icon -->
      <svg id="close-icon" class="w-6 h-6 hidden transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile / Tablet Navigation Panel -->
  <div
    id="mobile-menu"
    class="hidden md:hidden absolute top-full left-0 right-0 w-full border-t border-slate-200/80 bg-[#F8FAFC] backdrop-blur-lg shadow-2xl transition-all duration-300 max-h-[calc(100vh-5rem)] overflow-y-auto z-50"
  >
    <div class="px-4 pt-3 pb-2 flex flex-col gap-1.5">
      {/* Company Link & Accordion */}
      <div class="mobile-accordion-item pb-1">
        <div class="flex items-center justify-start">
          <a
            href="/#advantage"
            class="mobile-nav-link py-3 pl-3 pr-1.5 text-xl sm:text-2xl font-medium text-slate-800 hover:text-[#2563EB] rounded-l-xl hover:bg-blue-50/60 transition-colors"
          >
            Company
          </a>
          <button
            type="button"
            class="mobile-accordion-button py-3 px-2 text-slate-500 hover:text-[#2563EB] rounded-r-xl hover:bg-blue-50/60 transition-colors flex items-center justify-center"
            aria-label="Toggle Company Menu"
          >
            <svg class="w-5 h-5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
        <div class="mobile-accordion-content hidden border-t border-b border-slate-300 my-2 py-2 pl-3">
          <a
            href="/about"
            class="mobile-nav-link flex items-center gap-3 py-2.5 px-3 text-lg font-medium text-slate-700 hover:text-[#2563EB] rounded-lg hover:bg-blue-50/40 transition-colors"
          >
            <div class="w-9 h-9 rounded-full bg-blue-50 text-[#2563EB] flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <span>About Us</span>
          </a>
        </div>
      </div>

      {/* Services Link & Accordion */}
      <div class="mobile-accordion-item pb-1">
        <div class="flex items-center justify-start">
          <a
            href="/services"
            class="mobile-nav-link py-3 pl-3 pr-1.5 text-xl sm:text-2xl font-medium text-slate-800 hover:text-[#2563EB] rounded-l-xl hover:bg-blue-50/60 transition-colors"
          >
            Services
          </a>
          <button
            type="button"
            class="mobile-accordion-button py-3 px-2 text-slate-500 hover:text-[#2563EB] rounded-r-xl hover:bg-blue-50/60 transition-colors flex items-center justify-center"
            aria-label="Toggle Services List"
          >
            <svg class="w-5 h-5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
        <div class="mobile-accordion-content hidden border-t border-b border-slate-300 my-2 py-2 pl-2 space-y-1">
          {servicesList.map((service, index) => (
            <a
              href={`/services/${service.slug}`}
              class="mobile-nav-link flex items-center gap-3.5 p-2.5 rounded-xl hover:bg-blue-50/60 transition-colors"
            >
              <div class="w-10 h-10 rounded-full bg-blue-50 text-[#2563EB] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={serviceSvgPaths[index % serviceSvgPaths.length]} />
                </svg>
              </div>
              <span class="text-lg font-medium text-slate-700 leading-tight">
                {service.name}
              </span>
            </a>
          ))}
        </div>
      </div>

      {/* Work Link */}
      <a
        href="/#recent-work"
        class="mobile-nav-link py-3 px-3 text-xl sm:text-2xl font-medium text-slate-800 hover:text-[#2563EB] rounded-xl hover:bg-blue-50/60 transition-colors"
      >
        Work
      </a>

      {/* Contact Link */}
      <a
        href="/#contact"
        class="mobile-nav-link py-3 px-3 text-xl sm:text-2xl font-medium text-slate-800 hover:text-[#2563EB] rounded-xl hover:bg-blue-50/60 transition-colors"
      >
        Contact
      </a>
    </div>

    {/* Request a Consultation Link */}
    <a
      href="/#contact"
      class="mobile-nav-link group flex items-center justify-start gap-2.5 w-full py-3.5 px-7 text-xl sm:text-2xl font-medium text-white bg-[#2563EB] hover:bg-[#1D4ED8] active:bg-[#1E40AF] transition-colors"
    >
      <span>Request a Consultation</span>
      <svg
        class="w-5 h-5 sm:w-6 sm:h-6 text-white group-hover:translate-x-1 transition-transform duration-200"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</header>

<script>
  // Dynamic header background and logo text scroll effect:
  // Starts out matching the top hero background color (#EFF6FF) with the full wordmark visible,
  // then smoothly transitions to the main page background color (#F8FAFC) and collapses
  // the text "Hill Stack Studio" when scrolling down, leaving only the mark.
  const header = document.getElementById('main-header');
  const wordmark = document.getElementById('header-wordmark');
  const brandLogoLink = document.getElementById('brand-logo-link');
  
  if (header) {
    const handleScroll = () => {
      if (window.scrollY > 20) {
        header.classList.add('bg-[#F8FAFC]/90', 'backdrop-blur-md', 'border-slate-200/80', 'shadow-xs');
        header.classList.remove('bg-[#EFF6FF]', 'border-transparent');
        if (brandLogoLink) {
          brandLogoLink.classList.remove('gap-3');
          brandLogoLink.classList.add('gap-0');
        }
        if (wordmark) {
          wordmark.classList.add('max-w-0', 'opacity-0', '-translate-x-2');
          wordmark.classList.remove('max-w-[240px]', 'opacity-100', 'translate-x-0');
        }
      } else {
        header.classList.add('bg-[#EFF6FF]', 'border-transparent');
        header.classList.remove('bg-[#F8FAFC]/90', 'backdrop-blur-md', 'border-slate-200/80', 'shadow-xs');
        if (brandLogoLink) {
          brandLogoLink.classList.add('gap-3');
          brandLogoLink.classList.remove('gap-0');
        }
        if (wordmark) {
          wordmark.classList.add('max-w-[240px]', 'opacity-100', 'translate-x-0');
          wordmark.classList.remove('max-w-0', 'opacity-0', '-translate-x-2');
        }
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  // Mobile/Tablet Hamburger Menu logic
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (menuButton && mobileMenu) {
    const toggleMenu = () => {
      menuButton.blur();
      const isOpen = !mobileMenu.classList.contains('hidden');
      if (isOpen) {
        mobileMenu.classList.add('hidden');
        menuButton.setAttribute('aria-expanded', 'false');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
        menuButton.setAttribute('aria-expanded', 'true');
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      }
    };

    menuButton.addEventListener('click', toggleMenu);

    // Submenu accordions in mobile menu
    const accordionButtons = mobileMenu.querySelectorAll('.mobile-accordion-button');
    accordionButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const parent = btn.closest('.mobile-accordion-item');
        const content = parent?.querySelector('.mobile-accordion-content');
        const svgIcon = btn.querySelector('svg');
        if (content) {
          content.classList.toggle('hidden');
          svgIcon?.classList.toggle('rotate-180');
        }
      });
    });

    // Close mobile menu when navigating
    const navLinks = mobileMenu.querySelectorAll('.mobile-nav-link');
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuButton.setAttribute('aria-expanded', 'false');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      });
    });
  }
</script>
