---
import schemaData from '../../public/schema.json';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Hill Stack Studio | Locally Rooted. AI Optimized.",
  description = "Hill Stack Studio ensures every local business has the visibility, technology and personal support needed to thrive in the age of AI search across Seattle, Puyallup, Tacoma, Pierce County and the Pacific Northwest.",
  image = "/dark-logo.svg"
} = Astro.props;

const siteUrl = Astro.site || new URL('https://hillstackstudio.com');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(image, siteUrl).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph / Social Sharing -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Hill Stack Studio" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />

  <!-- Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/dark-logo.svg" />

  <!-- Non-render-blocking Google Fonts (only actively used families) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:ital,wght@0,300;0,400;0,500;0,700;0,800;1,400;1,700&family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..800&family=Homemade+Apple&family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap"
  />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />
</head>
<body class="bg-gradient-to-b from-[#E3E9EF] via-[#F6F9FB] via-50% to-[#F6F9FB] text-[#1E293B] antialiased min-h-screen min-h-[100dvh] flex flex-col selection:bg-blue-100 selection:text-blue-900">
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-black focus:text-white focus:px-5 focus:py-3 focus:rounded-full focus:font-bold focus:text-sm focus:shadow-lg focus:outline-none"
  >
    Skip to main content
  </a>
  <slot />
</body>
</html>