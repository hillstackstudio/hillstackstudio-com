---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteContext from '../data/siteContext.json';
---

<BaseLayout
  title={`Privacy Policy | ${siteContext.companyName}`}
  description="Privacy Policy for Hill Stack Studio. Learn how we collect, use, and protect your information when visiting our website."
>
  <Header
    companyName={siteContext.companyName}
    email={siteContext.contact.email}
  />

  <main class="flex-grow flex flex-col">
    {/* Page Header Hero */}
    <section class="pt-14 pb-12 md:pt-20 md:pb-16 border-b border-slate-200/60 relative">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        {/* Breadcrumbs */}
        <nav class="flex items-center justify-start gap-2 text-xs md:text-sm text-slate-500 mb-6 font-medium" aria-label="Breadcrumb">
          <a href="/" class="hover:text-black transition-colors">
            Home
          </a>
          <svg class="w-3.5 h-3.5 text-slate-400 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18l6-6-6-6" />
          </svg>
          <span class="text-slate-800 font-bold">Privacy Policy</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white/85 backdrop-blur-md text-[#0B0F19] border border-white/60 shadow-xs mb-4">
          <span>Effective: 2026-10-24</span>
        </div>

        <h1 class="text-[2.5rem] sm:text-5xl md:text-6xl font-extrabold text-[#0B0F19] tracking-tight leading-[1.08] sm:leading-[1.12]">
          Privacy Policy
        </h1>
        <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed font-normal">
          This Privacy Policy explains how Hill Stack Studio (&ldquo;we&rdquo;, &ldquo;us&rdquo;) collects, uses, and shares information when you use our website at <a href="https://www.hillstackstudio.com" class="text-black font-semibold underline underline-offset-4 hover:text-slate-700 transition-colors">https://www.hillstackstudio.com</a> (the &ldquo;Site&rdquo;). It covers the Site only. It does not apply to our offline activities, apps, or other business systems (such as sales or customer support platforms).
        </p>
      </div>
    </section>

    {/* Policy Content Card */}
    <section class="py-12 md:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white/80 backdrop-blur-xl rounded-3xl p-8 sm:p-12 md:p-14 border border-white/60 shadow-[0_8px_30px_rgb(0,0,0,0.05)] space-y-10 text-slate-700 text-base sm:text-lg leading-relaxed">
          
          {/* 1. Information We Collect */}
          <div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B0F19] tracking-tight mb-4">
              Information We Collect
            </h2>
            <p class="mb-4">
              We collect the following categories of information, depending on how you use the Site:
            </p>
            <ul class="space-y-3 pl-2">
              <li class="flex items-start gap-3">
                <span class="text-black font-bold text-lg leading-none mt-1.5">•</span>
                <span><strong>Information you choose to submit via forms</strong> (for example, your name, email address, company, and message)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-black font-bold text-lg leading-none mt-1.5">•</span>
                <span><strong>Technical data automatically collected</strong> when you visit the Site, such as IP address, device and browser type, pages viewed, referring/exit pages, and approximate location</span>
              </li>
            </ul>
          </div>

          {/* 2. How We Use Information */}
          <div class="pt-8 border-t border-slate-200/60">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B0F19] tracking-tight mb-4">
              How We Use Information
            </h2>
            <ul class="space-y-3 pl-2">
              <li class="flex items-start gap-3">
                <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                <span>To operate, maintain, and secure the Site</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                <span>To respond to your inquiries and provide requested information</span>
              </li>
            </ul>
          </div>

          {/* 3. Cookies and Similar Technologies */}
          <div class="pt-8 border-t border-slate-200/60">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B0F19] tracking-tight mb-4">
              Cookies and Similar Technologies
            </h2>
            <p>
              We use cookies and similar technologies to run the Site and, where enabled, for analytics and advertising. Cookies help remember your preferences and understand how visitors use the Site. You can manage cookies in your browser settings.
            </p>
          </div>

          {/* 4. Sharing and Service Providers */}
          <div class="pt-8 border-t border-slate-200/60">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B0F19] tracking-tight mb-4">
              Sharing and Service Providers
            </h2>
            <div class="space-y-4">
              <p>
                We share information with companies that help us operate the Site (for example, hosting, analytics, security, payments, email delivery, and embedded content). These providers act on our instructions and are bound by appropriate safeguards.
              </p>
              <p class="font-medium text-[#0B0F19]">
                We do not sell personal information or share it for cross-context behavioral advertising.
              </p>
            </div>
          </div>

          {/* 5. Retention */}
          <div class="pt-8 border-t border-slate-200/60">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B0F19] tracking-tight mb-4">
              Retention
            </h2>
            <p>
              We keep personal information only as long as necessary for the purposes described above (generally about 12 months unless we need it longer to meet legal, tax, or security requirements).
            </p>
          </div>

          {/* 6. Your Privacy Choices and Rights */}
          <div class="pt-8 border-t border-slate-200/60">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B0F19] tracking-tight mb-4">
              Your Privacy Choices and Rights
            </h2>
            <p>
              Depending on your location, you may have rights to access, correct, or delete your information, and to object to or restrict certain processing. You can also withdraw consent where we rely on consent. To exercise these rights, contact us via <a href="/#contact" class="text-black font-semibold underline underline-offset-4 hover:text-slate-700 transition-colors">contact form</a>.
            </p>
          </div>

          {/* 7. Other United States State Laws */}
          <div class="pt-8 border-t border-slate-200/60">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B0F19] tracking-tight mb-4">
              Other United States State Laws
            </h2>
            <p>
              Residents of certain US states may have similar rights to access, correct, delete, or opt out of targeted advertising and certain profiling. We will honor applicable requests as required by law.
            </p>
          </div>

          {/* 8. Children */}
          <div class="pt-8 border-t border-slate-200/60">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B0F19] tracking-tight mb-4">
              Children
            </h2>
            <p>
              This Site is not intended for children.
            </p>
          </div>

          {/* 9. Changes */}
          <div class="pt-8 border-t border-slate-200/60">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B0F19] tracking-tight mb-4">
              Changes
            </h2>
            <p>
              We may update this Policy from time to time. We will change the &ldquo;Effective&rdquo; date above and post the updated version on the Site.
            </p>
          </div>

          {/* 10. How to Contact Us */}
          <div class="pt-8 border-t border-slate-200/60">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B0F19] tracking-tight mb-4">
              How to Contact Us
            </h2>
            <p class="mb-6">
              If you have questions or requests about this Policy or your information, please reach us by <a href="/#contact" class="text-black font-semibold underline underline-offset-4 hover:text-slate-700 transition-colors">contact form</a> or by email at <a href={`mailto:${siteContext.contact.email}`} class="text-black font-semibold underline underline-offset-4 hover:text-slate-700 transition-colors">{siteContext.contact.email}</a>.
            </p>
            <div class="flex items-center">
              <a
                href="/#contact"
                class="inline-flex items-center justify-center gap-2 bg-black hover:bg-slate-900 text-white font-bold py-3.5 px-8 rounded-full shadow-md hover:shadow-lg transition-all duration-200 active:scale-95 text-base"
              >
                <span>Go to Contact Form</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
