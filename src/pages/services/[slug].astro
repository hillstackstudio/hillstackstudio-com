---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import siteContext from '../../data/siteContext.json';
import { servicesData, getServiceBySlug, ServiceDetail } from '../../data/servicesData';

export async function getStaticPaths() {
  return servicesData.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

interface Props {
  service: ServiceDetail;
}

const { service } = Astro.props;

// If accessed directly without static path props
const currentService = service || getServiceBySlug(Astro.params.slug as string);

if (!currentService) {
  return Astro.redirect('/404');
}

// 9 SVG Icons matching the rest of the site
const getServiceSvgPath = (index: number) => {
  const paths = [
    // 0. Custom Web Design & Development (Monitor)
    "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    // 1. Generative Engine Optimization (Lightning)
    "M13 10V3L4 14h7v7l9-11h-7z",
    // 2. Consulting & Site Migration (Exchange)
    "M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4",
    // 3. Web Hosting & Administration (Server)
    "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01",
    // 4. Search Engine Readiness (Code/Schema)
    "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
    // 5. Copywriting & Content Adjustments (Pencil)
    "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z",
    // 6. Performance & Visibility Audit (Chart)
    "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
    // 7. Accessibility Compliance (Eye)
    "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z",
    // 8. Security & Privacy Compliance (Shield)
    "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
  ];
  return paths[index % paths.length];
};

const siblingServices = servicesData
  .filter((s) => s.slug !== currentService.slug)
  .slice(0, 3);
---

<BaseLayout 
  title={`${currentService.name} | ${siteContext.companyName}`}
  description={currentService.shortDescription}
>
  <Header 
    companyName={siteContext.companyName}
    email={siteContext.contact.email}
  />

  <main class="bg-[#F8FAFC] flex-grow flex flex-col">
    {/* Hero Section */}
    <section class="bg-gradient-to-b from-[#EFF6FF] via-[#F5F9FF] to-[#F8FAFC] pt-12 pb-16 md:pt-16 md:pb-24 border-b border-slate-200/60 relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        {/* Breadcrumbs */}
        <nav class="flex items-center gap-2 text-xs md:text-sm text-slate-500 mb-8 font-medium">
          <a href="/" class="hover:text-[#2563EB] transition-colors">
            Home
          </a>
          <span>/</span>
          <a href="/services" class="hover:text-[#2563EB] transition-colors">Services</a>
          <span>/</span>
          <span class="text-slate-800 font-bold truncate max-w-[200px] sm:max-w-none">{currentService.name}</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <div class="lg:col-span-7">
            {currentService.badge && (
              <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100/80 text-[#2563EB] text-xs sm:text-sm font-bold mb-6 border border-blue-200/60">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={getServiceSvgPath(currentService.iconIndex)} />
                </svg>
                <span>{currentService.badge}</span>
              </div>
            )}

            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-[#0B0F19] tracking-tight mb-6 leading-[1.15]">
              {currentService.name}
            </h1>

            <p class="text-lg sm:text-xl text-[#2563EB] font-semibold mb-6">
              {currentService.tagline}
            </p>

            <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-8 max-w-3xl">
              {currentService.heroDescription}
            </p>

            <div class="flex flex-wrap items-center gap-4">
              <a
                href="/services"
                class="inline-flex items-center justify-center gap-2 bg-white hover:bg-slate-50 text-slate-700 font-bold py-3.5 px-7 rounded-full border border-slate-200/90 shadow-xs hover:shadow-md transition-all duration-200 text-base"
              >
                <span>Explore All Services</span>
              </a>
              <a
                href="/#contact"
                class="inline-flex items-center justify-center gap-2 bg-[#2563EB] hover:bg-[#1D4ED8] text-white font-bold py-3.5 px-8 rounded-full shadow-sm hover:shadow-md transition-all duration-200 active:scale-95 text-base"
              >
                <span>Request a Consultation</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>

          {/* Service Icon / Image Visual Container */}
          <div class="lg:col-span-5 flex justify-center items-center">
            {currentService.heroImage ? (
              <div class={`relative w-full max-w-md lg:max-w-lg flex items-center justify-center ${currentService.flipHeroImage ? '-scale-x-100' : ''}`}>
                <img 
                  src={currentService.heroImage} 
                  alt={`${currentService.name} Visual`} 
                  class="w-full h-auto max-h-[320px] sm:max-h-[380px] lg:max-h-[420px] object-contain hover:scale-105 transition-transform duration-300 drop-shadow-lg"
                />
              </div>
            ) : (
              <div class="relative w-full max-w-sm bg-white rounded-3xl p-8 sm:p-10 border border-slate-200/80 shadow-xl text-center group">
                <div class="w-24 h-24 mx-auto rounded-3xl bg-blue-50 text-[#2563EB] flex items-center justify-center mb-6 shadow-inner group-hover:scale-105 group-hover:bg-[#2563EB] group-hover:text-white transition-all duration-300">
                  <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d={getServiceSvgPath(currentService.iconIndex)} />
                  </svg>
                </div>
                <div class="text-[#0B0F19] font-bold text-lg mb-2">Locally Rooted. AI Optimized.</div>
                <p class="text-xs text-slate-500 leading-relaxed">
                  Empowering Pacific Northwest contractors & service providers with enterprise-grade web technology.
                </p>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    {/* Key Capabilities / Features Section */}
    <section class="py-16 md:py-24 bg-white border-b border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-[#2563EB] text-sm font-bold uppercase tracking-wider block mb-2">
            Service Capabilities
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0B0F19] tracking-tight">
            What's Included in This Service
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {currentService.features.map((feature, idx) => (
            <div class="bg-[#F8FAFC] rounded-2xl p-8 border border-slate-200/80 hover:border-blue-500/40 hover:shadow-lg transition-all duration-300 flex items-start gap-5 group">
              <div class="w-10 h-10 rounded-xl bg-blue-50 text-[#2563EB] group-hover:bg-[#2563EB] group-hover:text-white flex items-center justify-center shrink-0 font-bold transition-colors">
                {idx + 1}
              </div>
              <div>
                <h3 class="text-xl font-bold text-[#0B0F19] mb-2 group-hover:text-[#2563EB] transition-colors">
                  {feature.title}
                </h3>
                <p class="text-slate-600 leading-relaxed text-sm md:text-base">
                  {feature.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* AI Search & Local Impact Banner */}
    <section class="py-16 md:py-24 bg-[#0B0F19] text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#2563EB_1px,transparent_1px)] [background-size:16px_16px]"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-4xl mx-auto bg-slate-900/90 rounded-3xl p-8 sm:p-12 border border-slate-800 shadow-2xl backdrop-blur-sm">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 text-[#2563EB] text-xs font-bold mb-4 uppercase tracking-wider border border-blue-500/30">
            AI Visibility & Local Advantage
          </div>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white mb-6 leading-tight">
            {currentService.aiImpactTitle}
          </h2>
          <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-8">
            {currentService.aiImpactDescription}
          </p>

          <div class="pt-6 border-t border-slate-800 flex items-center justify-end text-xs text-slate-400">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              Optimized for ChatGPT, Copilot, Perplexity & Gemini
            </span>
          </div>
        </div>
      </div>
    </section>

    {/* Methodology & Process */}
    <section class="py-16 md:py-24 bg-[#F8FAFC] border-b border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-[#2563EB] text-sm font-bold uppercase tracking-wider block mb-2">
            Execution Workflow
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0B0F19] tracking-tight">
            How We Deliver Results
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {currentService.processSteps.map((step) => (
            <div class="bg-white rounded-2xl p-7 border border-slate-200/80 shadow-xs flex flex-col justify-between hover:shadow-md transition-shadow">
              <div>
                <span class="text-3xl font-black text-[#2563EB]/30 block mb-3 font-mono">
                  {step.stepNumber}
                </span>
                <h3 class="text-lg font-bold text-[#0B0F19] mb-2">
                  {step.title}
                </h3>
                <p class="text-slate-600 text-sm leading-relaxed">
                  {step.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Deliverables Section */}
    <section class="py-16 md:py-24 bg-white border-b border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-5">
            <span class="text-[#2563EB] text-sm font-bold uppercase tracking-wider block mb-2">
              Tangible Results
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0B0F19] tracking-tight mb-6">
              Key Deliverables
            </h2>
            <p class="text-slate-600 leading-relaxed text-base mb-6">
              When you partner with Hill Stack Studio, you receive clear, high-impact deliverables designed to drive measurable growth and long-term digital authority.
            </p>
            <a
              href="/#contact"
              class="inline-flex items-center gap-2 text-[#2563EB] font-bold text-sm hover:underline"
            >
              <span>Have questions about deliverables? Talk to our team</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

          <div class="lg:col-span-7 bg-[#F8FAFC] rounded-3xl p-8 border border-slate-200/80 shadow-xs">
            <ul class="space-y-4">
              {currentService.deliverables.map((item) => (
                <li class="flex items-start gap-3.5 text-slate-700 font-medium text-base">
                  <div class="w-6 h-6 rounded-full bg-blue-100 text-[#2563EB] flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* Frequently Asked Questions */}
    {currentService.faq && currentService.faq.length > 0 && (
      <section class="py-16 md:py-24 bg-[#F8FAFC] border-b border-slate-200/80">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-12">
            <span class="text-[#2563EB] text-sm font-bold uppercase tracking-wider block mb-2">
              Got Questions?
            </span>
            <h2 class="text-3xl font-extrabold text-[#0B0F19]">
              Frequently Asked Questions
            </h2>
          </div>

          <div class="space-y-6">
            {currentService.faq.map((item) => (
              <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-xs">
                <h3 class="text-lg font-bold text-[#0B0F19] mb-3">
                  {item.question}
                </h3>
                <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                  {item.answer}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* Explore Sibling Services */}
    <section class="py-16 md:py-24 bg-white border-b border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-12 gap-4">
          <div>
            <span class="text-[#2563EB] text-sm font-bold uppercase tracking-wider block mb-2">
              Explore More Solutions
            </span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B0F19]">
              Related Services
            </h2>
          </div>
          <a
            href="/services"
            class="text-[#2563EB] font-bold text-sm hover:underline flex items-center gap-1 shrink-0"
          >
            <span>View All 9 Services</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {siblingServices.map((sibling) => (
            <a
              href={`/services/${sibling.slug}`}
              class="group bg-[#F8FAFC] rounded-2xl p-7 border border-slate-200/80 hover:border-blue-500/40 hover:bg-white hover:shadow-xl transition-all duration-300 flex flex-col justify-between"
            >
              <div>
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-[#2563EB] flex items-center justify-center mb-5 group-hover:bg-[#2563EB] group-hover:text-white transition-colors">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={getServiceSvgPath(sibling.iconIndex)} />
                  </svg>
                </div>
                <h3 class="text-lg font-bold text-[#0B0F19] mb-2 group-hover:text-[#2563EB] transition-colors">
                  {sibling.name}
                </h3>
                <p class="text-slate-600 text-xs sm:text-sm line-clamp-3 leading-relaxed">
                  {sibling.shortDescription}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-200/60 flex items-center justify-end gap-1 text-[#2563EB] text-xs font-bold">
                <span>Learn details</span>
                <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* Section Bottom Action */}
    <section class="py-16 bg-[#EFF6FF]/60">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B0F19] mb-4">
          Ready to Elevate Your Service Visibility in AI Search?
        </h2>
        <p class="text-slate-600 text-base mb-8 max-w-xl mx-auto">
          Get in touch with our team for plain-English guidance and a personalized visibility action plan.
        </p>
        <a
          href="/#contact"
          class="inline-flex items-center gap-2 bg-[#2563EB] hover:bg-[#1D4ED8] text-white font-bold py-3.5 px-8 rounded-full shadow-sm hover:shadow-md transition-all duration-200 active:scale-95 text-base"
        >
          <span>Get Your Free Audit & Consultation</span>
        </a>
      </div>
    </section>
  </main>

  <Footer 
    companyName={siteContext.companyName}
    email={siteContext.contact.email}
  />
</BaseLayout>
