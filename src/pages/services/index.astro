---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import siteContext from '../../data/siteContext.json';
import { servicesData } from '../../data/servicesData';

// 9 SVG Icons matching the rest of the site
const getServiceSvgPath = (index: number) => {
  const paths = [
    // 0. Custom Web Design & Development (Monitor)
    "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    // 1. Generative Engine Optimization (Lightning)
    "M13 10V3L4 14h7v7l9-11h-7z",
    // 2. Consulting & Site Migration (Exchange)
    "M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4",
    // 3. Web Hosting & Administration (Server)
    "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01",
    // 4. Search Engine Readiness (Code/Schema)
    "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
    // 5. Copywriting & Content Adjustments (Pencil)
    "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z",
    // 6. Performance & Visibility Audit (Chart)
    "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
    // 7. Accessibility Compliance (Eye)
    "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z",
    // 8. Security & Privacy Compliance (Shield)
    "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
  ];
  return paths[index % paths.length];
};
---

<BaseLayout 
  title={`Our Services | ${siteContext.companyName}`}
  description="Explore Hill Stack Studio's 9 core web services including Custom Astro Development, Generative Engine Optimization (GEO), Site Migration, and AI Search Audits."
>
  <Header 
    companyName={siteContext.companyName}
    email={siteContext.contact.email}
  />

  <main class="bg-[#F8FAFC] flex-grow flex flex-col">
    {/* Page Header Hero */}
    <section class="bg-gradient-to-b from-[#E6F6F5] via-[#F0F9F8] to-[#F8FAFC] pt-14 pb-16 md:pt-20 md:pb-24 border-b border-slate-200/60 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        
        {/* Breadcrumbs */}
        <nav class="flex items-center justify-center gap-2 text-xs md:text-sm text-slate-500 mb-6 font-medium">
          <a href="/" class="hover:text-[#17A398] transition-colors flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span>Home</span>
          </a>
          <span>/</span>
          <span class="text-slate-800 font-bold">Services</span>
        </nav>

        <span class="text-[#17A398] text-sm font-bold uppercase tracking-wider mb-3 block">
          Comprehensive Web & AI Visibility Solutions
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-[#0B0F19] tracking-tight mb-6 max-w-4xl mx-auto leading-[1.15]">
          Core Customer Services
        </h1>
        <p class="text-lg sm:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
          We combine personal consulting with Generative Engine Optimization (GEO) and sub-second Astro web engineering to keep Pacific Northwest businesses ahead of the curve.
        </p>
      </div>
    </section>

    {/* All 9 Services Grid */}
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {servicesData.map((service, index) => (
            <a
              href={`/services/${service.slug}`}
              class="group bg-white rounded-2xl p-8 border border-slate-200/80 shadow-xs hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between"
            >
              <div>
                <div class="w-12 h-12 rounded-2xl bg-teal-50 text-[#17A398] flex items-center justify-center mb-6 group-hover:bg-[#17A398] group-hover:text-white transition-colors duration-300 shadow-xs">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={getServiceSvgPath(service.iconIndex)} />
                  </svg>
                </div>

                <h2 class="text-xl font-bold text-[#0B0F19] mb-3 group-hover:text-[#17A398] transition-colors leading-snug">
                  {service.name}
                </h2>
                <p class="text-slate-600 leading-relaxed text-base md:text-lg">
                  {service.shortDescription}
                </p>
              </div>

              <div class="mt-8 pt-4 border-t border-slate-100 flex items-center justify-between text-[#17A398] text-sm font-bold">
                <span>Explore Service Details</span>
                <div class="w-8 h-8 rounded-full bg-teal-50 group-hover:bg-[#17A398] group-hover:text-white flex items-center justify-center transition-colors">
                  <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* Bottom Call to Action */}
    <section class="py-16 bg-[#E6F6F5]/60 border-t border-slate-200/80">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl font-extrabold text-[#0B0F19] mb-4">
          Need Guidance Choosing the Right Strategy?
        </h2>
        <p class="text-slate-600 text-lg mb-8 max-w-xl mx-auto">
          Contact Hill Stack Studio for a plain-English consultation and a custom digital visibility plan for your business.
        </p>
        <a
          href="/#contact"
          class="inline-flex items-center gap-2 bg-[#17A398] hover:bg-[#128279] text-white font-bold py-3.5 px-8 rounded-full shadow-lg shadow-teal-500/25 hover:shadow-teal-500/35 transition-all duration-200 active:scale-95 text-base"
        >
          <span>Schedule Your Consultation</span>
        </a>
      </div>
    </section>
  </main>

  <Footer 
    companyName={siteContext.companyName}
    email={siteContext.contact.email}
  />
</BaseLayout>
