---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import siteContext from '../../data/siteContext.json';
import HandDrawnArrow from '../../components/HandDrawnArrow.astro';
---

<BaseLayout 
  title={`Our Solutions & Services | ${siteContext.companyName}`}
  description="Discover Hill Stack Studio's 3 core solutions: Intake Call strategy, Answer Engine Optimization (AEO) Audit, and Custom Website Rebuilds."
>
  <Header 
    companyName={siteContext.companyName}
    email={siteContext.contact.email}
  />

  <main class="bg-[#F9FAFC] flex-grow flex flex-col">
    {/* Page Header Hero */}
    <section class="bg-gradient-to-b from-[#EFF6FF] via-[#F4F8FD] to-[#F9FAFC] pt-14 pb-16 md:pt-20 md:pb-24 border-b border-slate-200/60 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        
        {/* Breadcrumbs */}
        <nav class="flex items-center justify-start gap-2 text-xs md:text-sm text-slate-500 mb-6 font-medium">
          <a href="/" class="hover:text-black transition-colors">
            Home
          </a>
          <svg class="w-3.5 h-3.5 text-slate-400 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18l6-6-6-6" />
          </svg>
          <span class="text-slate-800 font-bold">Services</span>
        </nav>

        <h1 class="text-[2.5rem] sm:text-5xl md:text-6xl font-extrabold text-[#0B0F19] tracking-tight max-w-4xl mx-auto leading-[1.08] sm:leading-[1.12]">
          Custom solutions tailored for local success
        </h1>
        <p class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto mt-4 leading-relaxed font-normal">
          A clear, proven path to elevate your local business with modern engineering and high discoverability across traditional &amp; AI search.
        </p>
      </div>
    </section>

    {/* 3 Horizontal Solution Cards */}
    <section class="py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col">
          
          {/* Card 1: Intake Call */}
          <div class="bg-white rounded-3xl p-8 sm:p-10 md:p-12 border border-slate-200/80 shadow-md hover:shadow-xl transition-all duration-300">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 lg:gap-12">
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-4">
                  <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-100 text-[#0B0F19] border border-slate-200/80 shrink-0">
                    Step 01
                  </span>
                  <h2 class="text-[2rem] sm:text-3xl md:text-4xl font-extrabold text-[#0B0F19] tracking-tight leading-[1.08]">
                    Intake call
                  </h2>
                </div>
                <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-6 max-w-2xl">
                  A dedicated 1-on-1 strategy session to understand your business, target audience, and local service market. We review your current online footprint, identify visibility bottlenecks, and establish clear digital goals.
                </p>
                <ul class="space-y-2.5 text-sm sm:text-base text-slate-700">
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>1-on-1 strategy session with our founders</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Full review of your existing search footprint</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Plain-English AI search opportunity roadmap</span>
                  </li>
                </ul>
              </div>

              <div class="lg:w-80 shrink-0 pt-6 lg:pt-0 border-t lg:border-t-0 lg:border-l border-slate-100 lg:pl-10 flex flex-col justify-center">
                <a
                  href="/#contact"
                  class="inline-flex items-center justify-center gap-2 bg-black hover:bg-slate-900 text-white font-bold py-3.5 px-6 rounded-full shadow-md hover:shadow-lg transition-all duration-200 active:scale-95 text-base w-full"
                >
                  <span>Schedule Intake Call</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>

          {/* Hand-drawn Arrow connecting Intake Call to AEO Audit */}
          <HandDrawnArrow />

          {/* Card 2: AEO Audit */}
          <div class="bg-white rounded-3xl p-8 sm:p-10 md:p-12 border border-slate-200/80 shadow-md hover:shadow-xl transition-all duration-300">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 lg:gap-12">
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-4">
                  <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-100 text-[#0B0F19] border border-slate-200/80 shrink-0">
                    Step 02
                  </span>
                  <h2 class="text-[2rem] sm:text-3xl md:text-4xl font-extrabold text-[#0B0F19] tracking-tight leading-[1.08]">
                    AEO &amp; SEO website audit
                  </h2>
                </div>
                <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-6 max-w-2xl">
                  An exhaustive inspection of how conversational AI engines (ChatGPT, Google Gemini, Claude, Siri) and search crawlers perceive, index, and cite your business against local competitors.
                </p>
                <ul class="space-y-2.5 text-sm sm:text-base text-slate-700">
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>5 Pillars of AI Visibility comprehensive audit</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Live query testing on ChatGPT, Gemini &amp; Siri</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Local competitor recommendation gap analysis</span>
                  </li>
                </ul>
              </div>

              <div class="lg:w-80 shrink-0 pt-6 lg:pt-0 border-t lg:border-t-0 lg:border-l border-slate-100 lg:pl-10 flex flex-col justify-center">
                <a
                  href="/#contact"
                  class="inline-flex items-center justify-center gap-2 bg-black hover:bg-slate-900 text-white font-bold py-3.5 px-6 rounded-full shadow-md hover:shadow-lg transition-all duration-200 active:scale-95 text-base w-full mb-3"
                >
                  <span>Request an AEO Audit</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
                <a
                  href="/services/answer-engine-optimization"
                  class="text-xs sm:text-sm font-semibold text-slate-600 hover:text-black transition-colors text-center inline-flex items-center justify-center gap-1"
                >
                  <span>Explore AEO Details</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>

          {/* Hand-drawn Arrow connecting AEO Audit to Rebuild Custom Website */}
          <HandDrawnArrow />

          {/* Card 3: Rebuild Custom Website */}
          <div class="bg-white rounded-3xl p-8 sm:p-10 md:p-12 border border-slate-200/80 shadow-md hover:shadow-xl transition-all duration-300">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 lg:gap-12">
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-4">
                  <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-100 text-[#0B0F19] border border-slate-200/80 shrink-0">
                    Step 03
                  </span>
                  <h2 class="text-[2rem] sm:text-3xl md:text-4xl font-extrabold text-[#0B0F19] tracking-tight leading-[1.08]">
                    Rebuild custom website
                  </h2>
                </div>
                <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-6 max-w-2xl">
                  A ground-up website rebuild engineered with clean, lightweight Astro code for instant sub-second page loads, conversion-focused mobile layouts, and machine-readable structured data.
                </p>
                <ul class="space-y-2.5 text-sm sm:text-base text-slate-700">
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>100% custom code with zero heavy CMS bloat</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Sub-second load times &amp; 90+ Lighthouse scores</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Embedded JSON-LD schema &amp; llms.txt standards</span>
                  </li>
                </ul>
              </div>

              <div class="lg:w-80 shrink-0 pt-6 lg:pt-0 border-t lg:border-t-0 lg:border-l border-slate-100 lg:pl-10 flex flex-col justify-center">
                <a
                  href="/#contact"
                  class="inline-flex items-center justify-center gap-2 bg-black hover:bg-slate-900 text-white font-bold py-3.5 px-6 rounded-full shadow-md hover:shadow-lg transition-all duration-200 active:scale-95 text-base w-full mb-3"
                >
                  <span>Start Website Rebuild</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
                <a
                  href="/services/custom-web-design-development"
                  class="text-xs sm:text-sm font-semibold text-slate-600 hover:text-black transition-colors text-center inline-flex items-center justify-center gap-1"
                >
                  <span>Explore Engineering Details</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

  </main>

  <Footer 
    companyName={siteContext.companyName}
    email={siteContext.contact.email}
  />
</BaseLayout>

