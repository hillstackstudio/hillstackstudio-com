---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import siteContext from '../../data/siteContext.json';
---

<BaseLayout 
  title={`Our Solutions & Services | ${siteContext.companyName}`}
  description="Discover Hill Stack Studio's 4 core solutions: Intake Call strategy, Answer Engine Optimization (AEO) Audit, Custom Website Rebuilds, and Website Hosting & Administration."
>
  <Header 
    companyName={siteContext.companyName}
    email={siteContext.contact.email}
  />

  <main class="flex-grow flex flex-col">
    {/* Page Header Hero */}
    <section class="pt-14 pb-16 md:pt-20 md:pb-24 border-b border-slate-200/60 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        
        {/* Breadcrumbs */}
        <nav class="flex items-center justify-start gap-2 text-xs md:text-sm text-slate-500 mb-6 font-medium">
          <a href="/" class="hover:text-black transition-colors">
            Home
          </a>
          <svg class="w-3.5 h-3.5 text-slate-400 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18l6-6-6-6" />
          </svg>
          <span class="text-slate-800 font-bold">Services</span>
        </nav>

        <h1 class="text-[2.5rem] sm:text-5xl md:text-6xl font-extrabold text-[#0B0F19] tracking-tight max-w-4xl mx-auto leading-[1.08] sm:leading-[1.12]">
          Custom solutions tailored for local success
        </h1>
        <p class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto mt-4 leading-relaxed font-normal">
          Our clear, proven path to elevate your local business with quality engineering and high discoverability across traditional &amp; modern search.
        </p>
      </div>
    </section>

    {/* 4 Horizontal Solution Cards */}
    <section class="py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col">
          
          {/* Card 1: Intake Call */}
          <div
            id="intake-call"
            class="scroll-mt-24 sm:scroll-mt-28 relative overflow-hidden rounded-3xl p-8 sm:p-10 md:p-12 border border-slate-200/80 shadow-[0_8px_30px_rgb(0,0,0,0.05)] hover:border-slate-300 hover:shadow-[0_16px_36px_-6px_rgba(15,23,42,0.1)] transition-all duration-300"
            style="background: radial-gradient(circle at top right, rgba(22, 159, 148, 0.16) 0%, rgba(22, 159, 148, 0.04) 45%, transparent 70%), #FFFFFF;"
          >
            <div
              class="absolute -top-12 -right-12 w-48 h-48 rounded-full bg-[#169F94]/10 blur-2xl pointer-events-none"
              aria-hidden="true"
            />
            <span id="intake" class="sr-only"></span>
            <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-8 lg:gap-12">
              <div class="flex-1">
                <div class="flex flex-col sm:flex-row sm:items-center items-start gap-3 sm:gap-4 mb-4">
                  <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white/85 backdrop-blur-md text-[#0B0F19] border border-white/60 shadow-xs shrink-0">
                    Step 01
                  </span>
                  <h2 class="text-[2rem] sm:text-3xl md:text-4xl font-extrabold text-[#0B0F19] tracking-tight leading-[1.08]">
                    Intake call
                  </h2>
                </div>
                <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-6 max-w-2xl">
                  The official starting line. This 1-on-1 session is where we align on your goals, take care of initial set up items, and get moving on your custom website.
                </p>
                <ul class="space-y-2.5 text-sm sm:text-base text-slate-700">
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Get to know you, your business and your goals to build on as the foundation of our project</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Decide together exactly which pages your site needs so it stays clean and focused</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Identify your ideal local customer and what makes them choose your business, pinpoint your ideal service area</span>
                  </li>
                </ul>
              </div>

              <div class="lg:w-80 shrink-0 pt-6 lg:pt-0 border-t lg:border-t-0 lg:border-l border-slate-200/60 lg:pl-10 flex flex-col justify-center">
                <a
                  href="/#contact"
                  class="inline-flex items-center justify-center gap-2 bg-black hover:bg-slate-900 text-white font-bold py-3.5 px-6 rounded-full shadow-md hover:shadow-lg transition-all duration-200 active:scale-95 text-base w-full"
                >
                  <span>Schedule Intake Call</span>
                </a>
              </div>
            </div>
          </div>

          {/* Vertical Dashed Line Divider */}
          <div class="w-px h-[72px] mx-auto my-8 sm:my-10 border-l border-dashed border-black" aria-hidden="true"></div>

          {/* Card 2: AEO Audit */}
          <div
            id="audit"
            class="scroll-mt-24 sm:scroll-mt-28 relative overflow-hidden rounded-3xl p-8 sm:p-10 md:p-12 border border-slate-200/80 shadow-[0_8px_30px_rgb(0,0,0,0.05)] hover:border-slate-300 hover:shadow-[0_16px_36px_-6px_rgba(15,23,42,0.1)] transition-all duration-300"
            style="background: radial-gradient(circle at top right, rgba(22, 159, 148, 0.16) 0%, rgba(22, 159, 148, 0.04) 45%, transparent 70%), #FFFFFF;"
          >
            <div
              class="absolute -top-12 -right-12 w-48 h-48 rounded-full bg-[#169F94]/10 blur-2xl pointer-events-none"
              aria-hidden="true"
            />
            <span id="aeo-audit" class="sr-only"></span>
            <span id="aeo-seo-audit" class="sr-only"></span>
            <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-8 lg:gap-12">
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-4">
                  <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white/85 backdrop-blur-md text-[#0B0F19] border border-white/60 shadow-xs shrink-0">
                    Step 02
                  </span>
                  <h2 class="text-[2rem] sm:text-3xl md:text-4xl font-extrabold text-[#0B0F19] tracking-tight leading-[1.08]">
                    AEO &amp; SEO website audit
                  </h2>
                </div>
                <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-6 max-w-2xl">
                  An in-depth look at why local customers might be missing your business online. We uncover why search engines and AI assistants are skipping over your website, then use those exact insights as the foundation to build a site that accurately reflects the quality of your business.
                </p>
                <ul class="space-y-2.5 text-sm sm:text-base text-slate-700">
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Review of your site's structure to uncover technical issues that keep you hidden from local search results</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Structure your business information so modern search engines &amp; tools can easily read and reference you as a top recommendation</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Identify whether your site contains the critical files needed for modern search engines to index your business for local searches</span>
                  </li>
                </ul>
              </div>

              <div class="lg:w-80 shrink-0 pt-6 lg:pt-0 border-t lg:border-t-0 lg:border-l border-slate-200/60 lg:pl-10 flex flex-col justify-center">
                <a
                  href="/#contact"
                  class="inline-flex items-center justify-center gap-2 bg-black hover:bg-slate-900 text-white font-bold py-3.5 px-6 rounded-full shadow-md hover:shadow-lg transition-all duration-200 active:scale-95 text-base w-full"
                >
                  <span>Request an AEO Audit</span>
                </a>
              </div>
            </div>
          </div>

          {/* Vertical Dashed Line Divider */}
          <div class="w-px h-[72px] mx-auto my-8 sm:my-10 border-l border-dashed border-black" aria-hidden="true"></div>

          {/* Card 3: Custom Website Rebuild */}
          <div
            id="web-design"
            class="scroll-mt-24 sm:scroll-mt-28 relative overflow-hidden rounded-3xl p-8 sm:p-10 md:p-12 border border-slate-200/80 shadow-[0_8px_30px_rgb(0,0,0,0.05)] hover:border-slate-300 hover:shadow-[0_16px_36px_-6px_rgba(15,23,42,0.1)] transition-all duration-300"
            style="background: radial-gradient(circle at top right, rgba(22, 159, 148, 0.16) 0%, rgba(22, 159, 148, 0.04) 45%, transparent 70%), #FFFFFF;"
          >
            <div
              class="absolute -top-12 -right-12 w-48 h-48 rounded-full bg-[#169F94]/10 blur-2xl pointer-events-none"
              aria-hidden="true"
            />
            <span id="rebuild" class="sr-only"></span>
            <span id="custom-website-rebuild" class="sr-only"></span>
            <span id="custom-web-design" class="sr-only"></span>
            <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-8 lg:gap-12">
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-4">
                  <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white/85 backdrop-blur-md text-[#0B0F19] border border-white/60 shadow-xs shrink-0">
                    Step 03
                  </span>
                  <h2 class="text-[2rem] sm:text-3xl md:text-4xl font-extrabold text-[#0B0F19] tracking-tight leading-[1.08]">
                    Custom website rebuild
                  </h2>
                </div>
                <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-6 max-w-2xl">
                  Using information found during our audit, we build you a custom website engineered on a modern foundation that makes it easy for search engines and your local customers to find you and book your services.
                </p>
                <ul class="space-y-2.5 text-sm sm:text-base text-slate-700">
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Engineered from the ground up without templates or plugins that slow down traditional small business sites</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Sub-second load times &amp; 90+ Lighthouse scores</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Guaranteed to meet all accessibility, security and web health standards - Lighthouse scores: 90+</span>
                  </li>
                </ul>
              </div>

              <div class="lg:w-80 shrink-0 pt-6 lg:pt-0 border-t lg:border-t-0 lg:border-l border-slate-200/60 lg:pl-10 flex flex-col justify-center">
                <a
                  href="/#contact"
                  class="inline-flex items-center justify-center gap-2 bg-black hover:bg-slate-900 text-white font-bold py-3.5 px-6 rounded-full shadow-md hover:shadow-lg transition-all duration-200 active:scale-95 text-base w-full"
                >
                  <span>Start Website Rebuild</span>
                </a>
              </div>
            </div>
          </div>

          {/* Vertical Dashed Line Divider */}
          <div class="w-px h-[72px] mx-auto my-8 sm:my-10 border-l border-dashed border-black" aria-hidden="true"></div>

          {/* Card 4: Website Hosting & Administration */}
          <div
            id="hosting"
            class="scroll-mt-24 sm:scroll-mt-28 relative overflow-hidden rounded-3xl p-8 sm:p-10 md:p-12 border border-slate-200/80 shadow-[0_8px_30px_rgb(0,0,0,0.05)] hover:border-slate-300 hover:shadow-[0_16px_36px_-6px_rgba(15,23,42,0.1)] transition-all duration-300"
            style="background: radial-gradient(circle at top right, rgba(22, 159, 148, 0.16) 0%, rgba(22, 159, 148, 0.04) 45%, transparent 70%), #FFFFFF;"
          >
            <div
              class="absolute -top-12 -right-12 w-48 h-48 rounded-full bg-[#169F94]/10 blur-2xl pointer-events-none"
              aria-hidden="true"
            />
            <span id="hosting-administration" class="sr-only"></span>
            <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-8 lg:gap-12">
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-4">
                  <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white/85 backdrop-blur-md text-[#0B0F19] border border-white/60 shadow-xs shrink-0">
                    Step 04
                  </span>
                  <h2 class="text-[2rem] sm:text-3xl md:text-4xl font-extrabold text-[#0B0F19] tracking-tight leading-[1.08]">
                    Website hosting &amp; administration
                  </h2>
                </div>
                <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-6 max-w-2xl">
                  Fast, quality cloud hosting and ongoing technical care. We handle your website's speed, security, backups and regular content updates for you behind the scenes. Your website will stay fast, safe, and always ready for your customers while you focus on the main thing, running your business.
                </p>
                <ul class="space-y-2.5 text-sm sm:text-base text-slate-700">
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>We run software updates, performance tweaks and security checks daily so you never have to worry about the technical details</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>Need to update your business hours or add a new service? Send us a quick message and we'll handle it for you</span>
                  </li>
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span>24/7 monitoring so your business remains online and reachable whenever local customers are looking for your services</span>
                  </li>
                </ul>
              </div>

              <div class="lg:w-80 shrink-0 pt-6 lg:pt-0 border-t lg:border-t-0 lg:border-l border-slate-200/60 lg:pl-10 flex flex-col justify-center">
                <a
                  href="/#contact"
                  class="inline-flex items-center justify-center gap-2 bg-black hover:bg-slate-900 text-white font-bold py-3.5 px-6 rounded-full shadow-md hover:shadow-lg transition-all duration-200 active:scale-95 text-base w-full"
                >
                  <span>Inquire About Hosting</span>
                </a>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

  </main>

  <Footer 
    companyName={siteContext.companyName}
    email={siteContext.contact.email}
  />
</BaseLayout>

