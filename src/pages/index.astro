---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.tsx';
import Services from '../components/Services.tsx';
import RecentWork from '../components/RecentWork.tsx';
import Advantage from '../components/Advantage.astro';
import WebsiteCost from '../components/WebsiteCost.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.tsx';
import Contact from '../components/Contact.tsx';
import Footer from '../components/Footer.astro';
import siteContext from '../data/siteContext.json';
---

<BaseLayout title="Hill Stack Studio | Performance Web Design, SEO & AEO">
  <Header 
    companyName={siteContext.companyName}
    email={siteContext.contact.email}
    transparentAtTop={true}
  />
  <main id="main-content" class="flex-grow flex flex-col">
    <Hero 
      client:load
      companyName={siteContext.companyName}
      tagline={siteContext.tagline}
      aboutText={siteContext.aboutText}
      primaryCallToAction={siteContext.primaryCallToAction}
      regionalKeywords={siteContext.regionalKeywords}
    />

    <RecentWork client:visible />
    <Services client:load services={siteContext.services} />
    <Advantage />
    <WebsiteCost />
    <Pricing />
    <Faq client:visible />
    <Contact 
      client:visible
      email={siteContext.contact.email}
    />
    <div class="w-full h-24 sm:h-32 md:h-36" aria-hidden="true"></div>
  </main>
  <Footer 
    companyName={siteContext.companyName}
    email={siteContext.contact.email}
  />
</BaseLayout>