---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteContext from '../data/siteContext.json';
---

<BaseLayout
  title={`About Us | ${siteContext.companyName}`}
  description="Learn about Hill Stack Studio: Locally rooted web engineering studio in the Pacific Northwest combining sub-second Astro websites with Answer Engine Optimization (AEO)."
>
  <Header
    companyName={siteContext.companyName}
    email={siteContext.contact.email}
  />

  <main class="relative bg-[#F4F4F8] flex-grow flex flex-col items-center text-center overflow-hidden">
    {/* Atmospheric Top Gradient Wash (Soft Blue / Surface tint matching site theme) */}
    <div 
      class="absolute top-0 inset-x-0 h-[540px] sm:h-[620px] pointer-events-none -z-0 overflow-hidden" 
      aria-hidden="true"
    >
      <div 
        class="absolute inset-0 bg-gradient-to-b from-[#EFF6FF] via-[#F4F8FD]/80 to-[#F4F4F8]"
      ></div>
      <div 
        class="absolute top-10 left-1/2 -translate-x-1/2 w-[720px] sm:w-[940px] h-[380px] rounded-full blur-3xl opacity-60 bg-gradient-to-br from-blue-100/70 via-indigo-50/40 to-transparent pointer-events-none"
      ></div>
    </div>

    {/* Reading Column Layout (Mirroring exact reference typographic cadence) */}
    <div class="relative z-10 w-full pt-16 sm:pt-24 md:pt-32 pb-24 sm:pb-36 md:pb-48 px-4 sm:px-6 font-alegreya-sans" style="font-family: 'Alegreya Sans', sans-serif;">
      
      {/* Hero Headline - Positioned outside description container for single-line display on desktop, no orphaned period on mobile */}
      <h1 
        class="font-fraunces text-[clamp(1.75rem,5.5vw,3.625rem)] font-bold text-[#0B0F19] tracking-[-0.025em] leading-[1.08] max-w-4xl mx-auto px-3 sm:px-4 text-center mb-9 sm:mb-10 md:mb-11"
        style="font-family: 'Fraunces', Georgia, serif;"
      >
        Hey, we're{" "}
        <span class="inline-block whitespace-nowrap">
          <span class="hand-drawn-wrapper">
            <span class="hand-drawn-text">Hill Stack Studio</span>
            <svg 
              class="hand-drawn-underline" 
              viewBox="0 0 280 24" 
              fill="none" 
              xmlns="http://www.w3.org/2000/svg"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <defs>
                <filter id="crayon-roughness-about" x="-10%" y="-40%" width="120%" height="180%" filterUnits="objectBoundingBox">
                  <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="4" result="noise" />
                  <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.4" xChannelSelector="R" yChannelSelector="G" result="displaced" />
                  <feMerge>
                    <feMergeNode in="displaced" />
                  </feMerge>
                </filter>
              </defs>
              <path 
                class="hand-drawn-path"
                d="M 6,17 C 52,19 118,13 182,10 C 218,8.5 254,9 275,13"
                stroke="#FBF719" 
                stroke-width="7" 
                stroke-linecap="round" 
                stroke-linejoin="round" 
                filter="url(#crayon-roughness-about)"
                opacity="0.95"
              />
              <path 
                class="hand-drawn-path"
                d="M 16,16 C 68,17.5 132,13 192,10.5 C 224,9.2 250,9.8 268,12"
                stroke="#FBF719" 
                stroke-width="4" 
                stroke-linecap="round" 
                stroke-linejoin="round" 
                filter="url(#crayon-roughness-about)"
                opacity="0.85"
              />
            </svg>
          </span>.
        </span>
      </h1>

      {/* Brand Logo - Positioned directly under headline with no white background */}
      <div class="flex justify-center mb-8 sm:mb-10">
        <img 
          src="/dark-logo.svg" 
          alt="Hill Stack Studio Icon" 
          class="w-14 h-14 sm:w-16 sm:h-16 object-contain rounded-2xl shadow-sm hover:scale-105 transition-transform duration-200" 
        />
      </div>

      {/* Vision & Mission Section */}
      <section class="max-w-4xl mx-auto px-4 sm:px-6 mb-4 text-center" aria-label="Vision and Mission">
        <div class="flex flex-col md:grid md:grid-cols-[1fr_auto_1fr] md:items-center md:gap-x-8 md:gap-y-4 max-w-3xl mx-auto">
          {/* Vision */}
          <div class="md:contents">
            <h2 
              class="text-3xl sm:text-4xl md:text-5xl font-bold font-fraunces text-[#0B0F19] tracking-tight leading-[1.08] mb-3 sm:mb-4 md:mb-0 md:col-start-1 md:row-start-1"
              style="font-family: 'Fraunces', Georgia, serif;"
            >
              Our Vision
            </h2>
            <p class="text-lg sm:text-xl md:text-[1.3125rem] font-alegreya-sans text-slate-700 leading-relaxed max-w-md mx-auto md:max-w-none md:col-start-1 md:row-start-2 md:self-center" style="font-family: 'Alegreya Sans', sans-serif;">
              A world where everyday people discover the local businesses best built to serve them.
            </p>
          </div>

          {/* Horizontal Dashed Line Divider Between Vision and Mission */}
          <div class="my-6 md:my-0 md:col-start-2 md:row-start-2 flex items-center justify-center flex-shrink-0 md:self-center px-1 sm:px-2" aria-hidden="true">
            <div class="w-12 md:w-[72px] border-t border-dashed border-black"></div>
          </div>

          {/* Mission */}
          <div class="md:contents">
            <h2 
              class="text-3xl sm:text-4xl md:text-5xl font-bold font-fraunces text-[#0B0F19] tracking-tight leading-[1.08] mb-3 sm:mb-4 md:mb-0 md:col-start-3 md:row-start-1"
              style="font-family: 'Fraunces', Georgia, serif;"
            >
              Our Mission
            </h2>
            <p class="text-lg sm:text-xl md:text-[1.3125rem] font-alegreya-sans text-slate-700 leading-relaxed max-w-md mx-auto md:max-w-none md:col-start-3 md:row-start-2 md:self-center" style="font-family: 'Alegreya Sans', sans-serif;">
              To help small businesses by providing access to quality engineering and the same technical solutions large companies use to stay ahead.
            </p>
          </div>
        </div>
      </section>

      {/* Vertical Dashed Tick Divider - Connecting Vision/Mission to Story */}
      <div class="w-px h-[72px] mx-auto mt-12 mb-[26px] border-l border-dashed border-black" aria-hidden="true"></div>

      {/* Story Section */}
      <header class="max-w-[528px] mx-auto px-4 sm:px-0">
        <h2 
          class="text-3xl sm:text-4xl md:text-5xl font-bold font-fraunces text-[#0B0F19] tracking-tight mb-6 sm:mb-8 leading-[1.08] text-center"
          style="font-family: 'Fraunces', Georgia, serif;"
        >
          <span class="hand-drawn-wrapper">
            <span class="hand-drawn-text">Our Story</span>
            <svg 
              class="hand-drawn-underline" 
              viewBox="0 0 280 24" 
              fill="none" 
              xmlns="http://www.w3.org/2000/svg"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <defs>
                <filter id="crayon-roughness-story" x="-10%" y="-40%" width="120%" height="180%" filterUnits="objectBoundingBox">
                  <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="4" result="noise" />
                  <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.4" xChannelSelector="R" yChannelSelector="G" result="displaced" />
                  <feMerge>
                    <feMergeNode in="displaced" />
                  </feMerge>
                </filter>
              </defs>
              <path 
                class="hand-drawn-path"
                d="M 6,17 C 52,19 118,13 182,10 C 218,8.5 254,9 275,13"
                stroke="#FBF719" 
                stroke-width="7" 
                stroke-linecap="round" 
                stroke-linejoin="round" 
                filter="url(#crayon-roughness-story)"
                opacity="0.95"
              />
              <path 
                class="hand-drawn-path"
                d="M 16,16 C 68,17.5 132,13 192,10.5 C 224,9.2 250,9.8 268,12"
                stroke="#FBF719" 
                stroke-width="4" 
                stroke-linecap="round" 
                stroke-linejoin="round" 
                filter="url(#crayon-roughness-story)"
                opacity="0.85"
              />
            </svg>
          </span>
        </h2>
        <p class="text-[1.3125rem] sm:text-[1.5rem] md:text-[1.625rem] leading-[1.35] font-bold text-[#0B0F19] max-w-[540px] mx-auto text-pretty font-alegreya-sans" style="font-family: 'Alegreya Sans', sans-serif;">
          The internet and search have moved forward. Most small business websites haven't, so we're here to help.
        </p>
      </header>

      {/* Horizontal Divider 1 */}
      <div class="w-12 sm:w-16 md:w-[72px] mx-auto my-12 border-t border-dashed border-black" aria-hidden="true"></div>

      {/* Narrative Section 2: Industry Shift & Search Transformation */}
      <article class="max-w-[540px] mx-auto px-4 sm:px-0 space-y-4 sm:space-y-5">
        <p class="text-lg sm:text-[1.25rem] md:text-[1.3125rem] leading-[1.5] text-slate-700 max-w-[540px] mx-auto text-pretty font-alegreya-sans" style="font-family: 'Alegreya Sans', sans-serif;">
          How people discover local businesses has fundamentally changed. Customers aren't just typing keywords into Google anymore. They're asking AI assistants (Siri, ChatGPT) through extended conversations for trusted business recommendations.
        </p>
        <p class="text-lg sm:text-[1.25rem] md:text-[1.3125rem] leading-[1.5] text-slate-700 max-w-[540px] mx-auto text-pretty font-alegreya-sans" style="font-family: 'Alegreya Sans', sans-serif;">
          Companies with full teams of engineers are currently making this transition. But for local businesses, from clinics and landscapers to neighborhood shops, access to these same technical resources, strategies and tools are often out of reach.
        </p>
      </article>

      {/* Horizontal Divider 2 */}
      <div class="w-12 sm:w-16 md:w-[72px] mx-auto my-12 border-t border-dashed border-black" aria-hidden="true"></div>

      {/* Narrative Section 3: The Need & Studio Mission */}
      <article class="max-w-[540px] mx-auto px-4 sm:px-0 space-y-4 sm:space-y-5">
        <p class="text-lg sm:text-[1.25rem] md:text-[1.3125rem] leading-[1.5] text-slate-700 max-w-[540px] mx-auto text-pretty font-alegreya-sans" style="font-family: 'Alegreya Sans', sans-serif;">
          It became clear to us that many amazing, hardworking business owners were at risk of being left behind simply because they didn't have the same access to enterprise-grade engineering and technology.
        </p>
        <p class="text-lg sm:text-[1.25rem] md:text-[1.3125rem] leading-[1.5] text-slate-700 max-w-[540px] mx-auto text-pretty font-alegreya-sans" style="font-family: 'Alegreya Sans', sans-serif;">
          Hill Stack Studio was founded to solve this problem. We provide modern engineering, Answer Engine Optimization (AEO), and full website redesigns paired with the strategic consulting our local businesses deserve.
        </p>
      </article>

      {/* Horizontal Divider 3 */}
      <div class="w-12 sm:w-16 md:w-[72px] mx-auto my-12 border-t border-dashed border-black" aria-hidden="true"></div>

      {/* Narrative Section 4: Community Focus & Commitment */}
      <article class="max-w-[540px] mx-auto px-4 sm:px-0 space-y-4 sm:space-y-5">
        <p class="text-lg sm:text-[1.25rem] md:text-[1.3125rem] leading-[1.5] text-slate-700 max-w-[540px] mx-auto text-pretty font-alegreya-sans" style="font-family: 'Alegreya Sans', sans-serif;">
          We started our agency because the small business owners in our community aren’t strangers to us. We believe that when you do exceptional, high-quality work, your community deserves to find you easily. That’s why we’re here: to bring technology to the forefront of hardworking local businesses.
        </p>
        <p class="text-lg sm:text-[1.25rem] md:text-[1.3125rem] leading-[1.5] text-slate-700 max-w-[540px] mx-auto text-pretty font-alegreya-sans" style="font-family: 'Alegreya Sans', sans-serif;">
          Technology should serve all businesses, not only those who can hire an engineering team.
        </p>
      </article>

    </div>

    {/* Gradient transition into the footer matching existing site pattern */}
    <div class="w-full h-24 sm:h-32 md:h-36 bg-gradient-to-b from-[#F4F4F8] to-[#F0F6FF]" aria-hidden="true"></div>
  </main>

  <Footer
    companyName={siteContext.companyName}
    email={siteContext.contact.email}
  />
</BaseLayout>
